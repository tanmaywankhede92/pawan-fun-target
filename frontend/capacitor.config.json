{
  "appId": "com.funtarget.app",
  "appName": "Fun Target",
  "webDir": "dist",
  "server": {
    "androidScheme": "https"
  },
  "android": {
    "allowMixedContent": true,
    "buildOptions": {
      "releaseType": "APK"
    }
  },
  "plugins": {
    "CapacitorHttp": {
      "enabled": true
    },
    "SplashScreen": {
      "launchAutoHide": true,
      "androidScaleType": "CENTER_CROP",
      "splashFullScreen": true,
      "splashImmersive": true,
      "backgroundColor": "#000000",
      "showSpinner": false,
      "launchShowDuration": 2,
      "resource": "splash"
    }
  }
}
